{
  "name": "every-ear-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Every Ear desktop wrapper (Electron) for macOS and Windows.",
  "main": "build/main.js",
  "scripts": {
    "build:tsc": "tsc -p tsconfig.json",
    "build": "npm run build:tsc",
    "dev": "npm run build && electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release:mac": "electron-builder --mac --publish always",
    "release:win": "electron-builder --win --publish always",
    "release:linux": "electron-builder --linux --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "^41.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@41.5.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.0": true
  }
}
