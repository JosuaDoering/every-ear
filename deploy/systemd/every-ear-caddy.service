[Unit]
Description=Every Ear Caddy (HTTPS reverse proxy)
Documentation=https://github.com/JosuaDoering/every-ear
After=network-online.target every-ear-backend.service every-ear-livekit.service
# Wants (not Requires): a backend/LiveKit restart should not tear Caddy down.
Wants=network-online.target every-ear-backend.service every-ear-livekit.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=every-ear
Group=every-ear
WorkingDirectory=/opt/every-ear
EnvironmentFile=/etc/every-ear/env
ExecStart=/opt/every-ear/bin/caddy run --config /opt/every-ear/Caddyfile --adapter caddyfile
ExecReload=/opt/every-ear/bin/caddy reload --config /opt/every-ear/Caddyfile --adapter caddyfile
Restart=always
RestartSec=1
LimitNOFILE=65535
# Listener port defaults to 8443 (unprivileged) — no CAP_NET_BIND_SERVICE needed.

[Install]
WantedBy=multi-user.target
